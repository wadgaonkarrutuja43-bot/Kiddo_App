<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_gradient"
    android:padding="24dp">

    <!-- Title with improved styling -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Mode"
        android:textSize="28sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"
        android:fontFamily="sans-serif-condensed"/>

    <!-- Learning Button with elevation and rounded corners -->
    <Button
        android:id="@+id/btnLearning"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:text="Learning"
        android:textSize="20sp"
        android:backgroundTint="@color/learning_blue"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:background="@drawable/button_rounded_corners"/>

    <!-- Games Button with elevation and rounded corners -->
    <Button
        android:id="@+id/btnGames"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:text="Games"
        android:textSize="20sp"
        android:backgroundTint="@color/game_green"
        android:textColor="@color/white"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:background="@drawable/button_rounded_corners"/>

</LinearLayout>