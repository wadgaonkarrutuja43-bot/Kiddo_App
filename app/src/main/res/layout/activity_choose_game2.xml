<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_gradient"
    android:padding="24dp"
    tools:context=".ChooseGameActivity2">

    <!-- New Game 1: Animal Sounds -->
    <Button
        android:id="@+id/btnAnimalSounds"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:text="Animal Sounds"
        android:textSize="20sp"
        android:backgroundTint="@color/learning_blue"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:background="@drawable/button_rounded_corners"/>

    <!-- New Game 2: Shape Tap -->
    <Button
        android:id="@+id/btnShapeTap"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:text="Shape Tap"
        android:textSize="20sp"
        android:backgroundTint="@color/game_green"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:background="@drawable/button_rounded_corners"/>

    <!-- Additional Mini-Games -->
    <Button
        android:id="@+id/btnBalloonGame"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:text="Balloon Pop Game"
        android:textSize="20sp"
        android:backgroundTint="@color/learning_blue"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:background="@drawable/button_rounded_corners"/>

    <Button
        android:id="@+id/btnColoringGame"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:text="Coloring Canvas"
        android:textSize="20sp"
        android:backgroundTint="@color/game_green"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:background="@drawable/button_rounded_corners"/>

    <Button
        android:id="@+id/btnMatchingGame"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:text="Matching Game"
        android:textSize="20sp"
        android:backgroundTint="@color/learning_blue"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:background="@drawable/button_rounded_corners"/>

    <Button
        android:id="@+id/btnFlashcards"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:text="Flashcards"
        android:textSize="20sp"
        android:backgroundTint="@color/game_green"
        android:textColor="@color/white"
        android:elevation="8dp"
        android:stateListAnimator="@null"
        android:background="@drawable/button_rounded_corners"/>

</LinearLayout>